// index.js
const express = require('express');
const cors = require('cors');
const crypto = require('crypto'); // Thư viện tạo ID tự động dạng UUID
const { sql, poolPromise } = require('./db');
require('dotenv').config();

const app = express();

// Middleware cấu hình hệ thống
app.use(cors());
app.use(express.json()); // Cho phép đọc dữ liệu dạng JSON gửi lên từ Client

// ==========================================
// 1. CHỨC NĂNG: ĐĂNG NHẬP NHÂN VIÊN (AUTH)
// ==========================================
app.post('/api/auth/login', async (req, res) => {
    try {
        const { username, password } = req.body;
        const pool = await poolPromise;
        
        const result = await pool.request()
            .input('username', sql.VarChar(50), username)
            .input('password', sql.VarChar(255), password)
            .query('SELECT id, full_name, username, role FROM employees WHERE username = @username AND password = @password AND deleted_at IS NULL');

        if (result.recordset.length > 0) {
            res.status(200).json({
                success: true,
                message: 'Đăng nhập thành công!',
                user: result.recordset[0]
            });
        } else {
            res.status(401).json({ success: false, message: 'Tài khoản hoặc mật khẩu không chính xác!' });
        }
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// ==========================================
// 2. CHỨC NĂNG: QUẢN LÝ KHÁCH HÀNG (CUSTOMERS - FULL CRUD)
// ==========================================

// Lấy danh sách tất cả khách hàng (Chưa bị xóa)
app.get('/api/customers', async (req, res) => {
    try {
        const pool = await poolPromise;
        const result = await pool.request()
            .query('SELECT * FROM customers WHERE deleted_at IS NULL ORDER BY created_at DESC');
        res.status(200).json({ success: true, data: result.recordset });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Lấy thông tin chi tiết 1 khách hàng theo ID
app.get('/api/customers/:id', async (req, res) => {
    try {
        const pool = await poolPromise;
        const result = await pool.request()
            .input('id', sql.VarChar(50), req.params.id)
            .query('SELECT * FROM customers WHERE id = @id AND deleted_at IS NULL');
        
        if (result.recordset.length === 0) {
            return res.status(404).json({ success: false, message: 'Không tìm thấy khách hàng!' });
        }
        res.status(200).json({ success: true, data: result.recordset[0] });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Thêm mới khách hàng
app.post('/api/customers', async (req, res) => {
    try {
        const { full_name, identity_card, phone } = req.body;
        const id = crypto.randomUUID(); // Tự động tạo chuỗi ID ngẫu nhiên không trùng lặp

        const pool = await poolPromise;
        await pool.request()
            .input('id', sql.VarChar(50), id)
            .input('full_name', sql.NVarChar(100), full_name)
            .input('identity_card', sql.VarChar(20), identity_card)
            .input('phone', sql.VarChar(20), phone)
            .query(`
                INSERT INTO customers (id, full_name, identity_card, phone, created_at, updated_at)
                VALUES (@id, @full_name, @identity_card, @phone, GETDATE(), GETDATE())
            `);

        res.status(201).json({ success: true, message: 'Thêm khách hàng thành công!', id });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Cập nhật thông tin khách hàng
app.put('/api/customers/:id', async (req, res) => {
    try {
        const { full_name, identity_card, phone } = req.body;
        const pool = await poolPromise;
        
        await pool.request()
            .input('id', sql.VarChar(50), req.params.id)
            .input('full_name', sql.NVarChar(100), full_name)
            .input('identity_card', sql.VarChar(20), identity_card)
            .input('phone', sql.VarChar(20), phone)
            .query(`
                UPDATE customers 
                SET full_name = @full_name, identity_card = @identity_card, phone = @phone, updated_at = GETDATE()
                WHERE id = @id AND deleted_at IS NULL
            `);

        res.status(200).json({ success: true, message: 'Cập nhật thông tin thành công!' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Xóa khách hàng (Xóa mềm - Soft Delete bằng cách cập nhật trường deleted_at)
app.delete('/api/customers/:id', async (req, res) => {
    try {
        const pool = await poolPromise;
        await pool.request()
            .input('id', sql.VarChar(50), req.params.id)
            .query('UPDATE customers SET deleted_at = GETDATE() WHERE id = @id');

        res.status(200).json({ success: true, message: 'Đã xóa khách hàng vào thùng rác!' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});


// ==========================================
// 3. CHỨC NĂNG: QUẢN LÝ PHÒNG (ROOMS)
// ==========================================

// Xem danh sách phòng
app.get('/api/rooms', async (req, res) => {
    try {
        const pool = await poolPromise;
        const result = await pool.request().query('SELECT * FROM rooms WHERE deleted_at IS NULL');
        res.status(200).json({ success: true, data: result.recordset });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Tạo phòng mới
app.post('/api/rooms', async (req, res) => {
    try {
        const { id, type, price, status } = req.body; // id phòng khách sạn thường tự đặt ví dụ: P101, P102
        const pool = await poolPromise;
        await pool.request()
            .input('id', sql.VarChar(50), id)
            .input('type', sql.VarChar(50), type)
            .input('price', sql.Decimal(18, 2), price)
            .input('status', sql.VarChar(50), status || 'ACTIVE')
            .query(`
                INSERT INTO rooms (id, type, price, status, created_at, updated_at)
                VALUES (@id, @type, @price, @status, GETDATE(), GETDATE())
            `);
        res.status(201).json({ success: true, message: 'Tạo phòng mới thành công!' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});


// ==========================================
// 4. CHỨC NĂNG: QUẢN LÝ THIẾT BỊ TRONG PHÒNG (DEVICES)
// ==========================================

// Lấy danh sách thiết bị và thông tin phòng chứa thiết bị đó (Dùng câu lệnh JOIN)
app.get('/api/devices', async (req, res) => {
    try {
        const pool = await poolPromise;
        const result = await pool.request().query(`
            SELECT d.*, r.type as room_type 
            FROM devices d 
            LEFT JOIN rooms r ON d.room_id = r.id 
            WHERE d.deleted_at IS NULL
        `);
        res.status(200).json({ success: true, data: result.recordset });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});

// Thêm thiết bị vào phòng
app.post('/api/devices', async (req, res) => {
    try {
        const { room_id, name, connection_type, status } = req.body;
        const id = crypto.randomUUID();
        const pool = await poolPromise;
        
        await pool.request()
            .input('id', sql.VarChar(50), id)
            .input('room_id', sql.VarChar(50), room_id)
            .input('name', sql.NVarChar(255), name)
            .input('connection_type', sql.VarChar(50), connection_type)
            .input('status', sql.VarChar(50), status || 'ONLINE')
            .query(`
                INSERT INTO devices (id, room_id, name, connection_type, status, created_at, updated_at)
                VALUES (@id, @room_id, @name, @connection_type, @status, GETDATE(), GETDATE())
            `);
        res.status(201).json({ success: true, message: 'Thêm thiết bị vào phòng thành công!', id });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});


// ==========================================
// 5. CHỨC NĂNG: ĐÁNH GIÁ DỌN PHÒNG (CLEANING REVIEWS)
// ==========================================

// Khách hàng gửi đánh giá dọn phòng (Score chỉ được nhận 1, 2, 3 dựa theo CHECK constraint trong DB)
app.post('/api/reviews', async (req, res) => {
    try {
        const { room_id, customer_id, employee_id, score } = req.body;
        const id = crypto.randomUUID();
        const pool = await poolPromise;

        await pool.request()
            .input('id', sql.VarChar(50), id)
            .input('room_id', sql.VarChar(50), room_id)
            .input('customer_id', sql.VarChar(50), customer_id)
            .input('employee_id', sql.VarChar(50), employee_id)
            .input('score', sql.Int, score)
            .query(`
                INSERT INTO cleaning_reviews (id, room_id, customer_id, employee_id, score, created_at, updated_at)
                VALUES (@id, @room_id, @customer_id, @employee_id, @score, GETDATE(), GETDATE())
            `);
        res.status(201).json({ success: true, message: 'Gửi đánh giá dịch vụ dọn phòng thành công!' });
    } catch (error) {
        res.status(500).json({ success: false, message: error.message });
    }
});


// Khởi chạy Server kết nối lắng nghe cổng PORT
const PORT = process.env.PORT || 3000;
app.listen(PORT, () => {
    console.log(`\n🚀 Server đang vận hành mượt mà tại: http://localhost:${PORT}`);
    console.log(`📌 Link kiểm tra danh sách phòng: http://localhost:${PORT}/api/rooms`);
    console.log(`📌 Link kiểm tra danh sách khách hàng: http://localhost:${PORT}/api/customers\n`);
});
